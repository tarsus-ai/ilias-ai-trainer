<?xml version="1.0" encoding="UTF-8"?>
<!-- Unit tests of the plugin's own logic. They need the interfaces of an
     ILIAS checkout: run with ILIAS_ROOT pointing at one, e.g.
     ILIAS_ROOT=/var/www/ilias php /var/www/ilias/vendor/composer/vendor/bin/phpunit -c phpunit.xml -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
    <testsuites>
        <testsuite name="Tarsus for ILIAS">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
