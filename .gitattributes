# Normalise line endings; the plugin is read by PHP on Linux servers.
* text=auto eol=lf
*.png binary
*.svg text

# Keep repository-only files out of `git archive` (the release zip):
docs/            export-ignore
.github/         export-ignore
.gitattributes   export-ignore
.gitignore       export-ignore
tests/           export-ignore
phpunit.xml      export-ignore
